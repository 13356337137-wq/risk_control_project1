[Unit]
Description=Risk Control API (FastAPI)
After=network.target mysql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/risk-control/backend
EnvironmentFile=/opt/risk-control/deploy/.env
ExecStart=/opt/risk-control/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
